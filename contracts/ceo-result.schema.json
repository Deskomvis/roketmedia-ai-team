{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "version",
    "sources",
    "confidence",
    "created_at",
    "status",
    "deliverable",
    "evidence",
    "risks",
    "handoff_to"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "needs_approval",
        "failed"
      ]
    },
    "deliverable": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "handoff_to": {
      "type": "string"
    },
    "plan": {
      "type": "object"
    },
    "task_assignments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "escalation": {
      "type": "object"
    },
    "daily_brief": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "CEO envelope: mandatory envelope + plan/task_assignments/escalation/daily_brief according to output kind.",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "plan"
          ]
        },
        {
          "required": [
            "task_assignments"
          ]
        },
        {
          "required": [
            "escalation"
          ]
        },
        {
          "required": [
            "daily_brief"
          ]
        }
      ]
    }
  ]
}
